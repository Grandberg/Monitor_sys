# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated list of allowed telegram user/chat IDs that can interact with the bot and receive alerts
ALLOWED_CHAT_IDS=123456789,987654321

# Multi-server registry (comma-separated)
# local:  ID|local
# ssh:    ID|ssh|user@host:port|/path/to/private_key
SERVERS=MY107|local,MYOR|ssh|opc@92.5.8.212:22|/keys/id_ed25519_monitor_myor
DEFAULT_SSH_KEY_PATH=/keys/id_ed25519_monitor_myor
SESSION_STORE_PATH=/data/sessions.json

# Monitoring Thresholds (in percentage)
CPU_THRESHOLD=85
RAM_THRESHOLD=85
DISK_THRESHOLD=90

# Intervals (in seconds)
CHECK_INTERVAL=60
# Alert cooldown per resource type (prevents spamming alerts, default 1800 seconds = 30 minutes)
ALERT_COOLDOWN=1800
# Alert delay (duration in seconds threshold must be exceeded continuously before alerting, default 300 seconds = 5 minutes)
CPU_ALERT_DELAY=300
RAM_ALERT_DELAY=300

# Path inside container where host system is mounted (used for chroot commands)
HOST_ROOT_PATH=/host/root
